{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visual-nce",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "nce.xiao27.com/*", "zone_name": "xiao27.com" }
  ]
}
