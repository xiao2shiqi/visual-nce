    {
      "id": "s12",
      "role": "Narrator",
      "text": "Suddenly my wife spotted a boat moored to the bank.",
      "translation": "突然间，我妻子发现在岸边停泊着一只船。",
      "startTime": 113.5,
      "endTime": 117.75,
