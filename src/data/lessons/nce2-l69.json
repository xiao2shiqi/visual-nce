            "meaning": "那个"
          }
        ]
      }
    },
    {
      "id": "intro_2",
      "role": "Narrator",
      "text": "I was being tested for a driving licence for the third time.",
      "translation": "我第三次接受驾驶执照考试。",
      "startTime": 18.03,
      "endTime": 23.37,
      "analysis": {
        "words": []
      }
    },
    {
      "id": "intro_3",
      "role": "Narrator",
      "text": "I had been asked to drive in heavy traffic and had done so successfully.",
      "translation": "我被要求在车辆繁忙的地方开车，我成功地做到了。",
      "startTime": 23.38,
      "endTime": 30.17,
      "analysis": {
        "words": []
      }
    },
    {
      "id": "intro_4",
      "role": "Narrator",
      "text": "After having been instructed to drive out of town, I began to acquire confidence.",
      "translation": "在被告知开出城镇后，我开始有了信心。",
      "startTime": 30.18,
      "endTime": 37.94,
      "analysis": {
        "words": []
      }
    },
    {
      "id": "s1",
      "role": "Man",
      "text": "Sure that I had passed, I was almost beginning to enjoy my test.",
      "translation": "确信自己已经通过了，我几乎开始享受起考试来了。",
      "startTime": 37.95,
      "endTime": 45.03,
      "analysis": {
        "words": [
          {
            "word": "That",
            "pos": "pron.",
            "meaning": "那个"
          },
          {
            "word": "My",
            "pos": "pron.",
            "meaning": "我的"
          }
        ]
      }
    },
    {
      "id": "s2",
      "role": "Woman",
      "text": "The examiner must have been pleased with my performance, for he smiled and said, 'Just one more thing Mr. Eames.",
      "translation": "主考人对我的驾驶想必是满意的，因为他微笑着说，'埃姆斯先生，还有一件事。",
      "startTime": 45.04,
      "endTime": 55.65,
      "analysis": {
        "words": [
          {
            "word": "My",
            "pos": "pron.",
            "meaning": "我的"
          }
        ]
      }
    },
    {
      "id": "s3",
      "role": "Man",
      "text": "Let us suppose that a child suddenly crosses the road in front of you.",
      "translation": "假设有一个小孩突然在你前面穿过马路。",
      "startTime": 55.66,
      "endTime": 61.74,
      "analysis": {
        "words": [
          {
            "word": "That",
            "pos": "pron.",
            "meaning": "那个"
          },
          {
            "word": "You",
            "pos": "pron.",
            "meaning": "你，你们"
          }
        ]
      }
    },
    {
      "id": "s4",
      "role": "Woman",
      "text": "As soon as I tap on the window, you must stop within five feet.'",
      "translation": "我一敲车窗，你必须在5英尺内停下。'",
      "startTime": 61.75,
      "endTime": 68.31,
      "analysis": {
        "words": [
          {
            "word": "You",
            "pos": "pron.",
            "meaning": "你，你们"
          },
          {
