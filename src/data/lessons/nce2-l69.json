            "meaning": "我（宾格）"
          }
        ]
      }
    },
    {
      "id": "s7",
      "role": "Man",
      "text": "I suddenly pressed the brake pedal hard and we were both thrown forward.",
      "translation": "我猛踩刹车踏板，我俩都向前冲去。",
      "startTime": 81.62,
      "endTime": 87.63,
      "analysis": {
        "words": []
      }
    },
    {
      "id": "s8",
      "role": "Woman",
      "text": "The examiner looked at me sadly.",
      "translation": "主考人伤心地看着我。",
      "startTime": 87.64,
      "endTime": 91.21,
