            "meaning": "行动，业务，手术"
          }
        ]
      }
    },
    {
      "id": "s1",
      "role": "Narrator",
      "text": "The small ship, Elkor, which had been searching the Barents Sea for weeks, was on its way home.",
      "translation": "那艘小船“埃尔科”号已经在巴伦支海搜索了几个星期，现在正处于返航途中。",
      "startTime": 19.2,
      "endTime": 26.71,
      "analysis": {
        "words": [
          {
            "word": "search",
            "pos": "v.",
            "meaning": "搜寻"
          }
        ]
      }
    },
    {
      "id": "s2",
      "role": "Narrator",
      "text": "A radio message from the mainland had been received by the ship's captain instructing him to give up the search.",
      "translation": "船长接到了来自大陆的电报，指示他放弃搜索。",
      "startTime": 26.72,
      "endTime": 34.52,
      "analysis": {
        "words": [
          {
            "word": "mainland",
            "pos": "n.",
            "meaning": "大陆"
          },
          {
            "word": "instructing",
            "pos": "v.",
            "meaning": "指导，指示"
          }
        ]
      }
    },
    {
      "id": "s3",
      "role": "Narrator",
      "text": "The captain knew that another attempt would be made later, for the sunken ship he was trying to find had been carrying a precious cargo of gold bullion.",
      "translation": "船长深知下次还会再尝试，因为他正试图寻找的那艘沉船上载有一批极其值钱的黄金金锭。",
      "startTime": 34.53,
      "endTime": 45.32,
      "analysis": {
