            "pos": "v.",
            "meaning": "达到"
          }
        ]
      }
    },
    {
      "id": "s5",
      "role": "Man",
      "text": "It is true that during their explorations they often faced difficulties and dangers of the most perilous nature,",
      "translation": "诚然，在他们的探险过程中，他们经常面临极其危险的困难和危机，",
      "startTime": 46.25,
      "endTime": 55.53,
      "analysis": {
        "words": [
          {
            "word": "Explorations",
            "pos": "n.",
            "meaning": "探险"
          },
          {
            "word": "Perilous",
            "pos": "adj.",
            "meaning": "危险的"
          }
        ]
      }
    },
    {
      "id": "s6",
      "role": "Woman",
      "text": "equipped in a manner which would make a modern climber shudder at the thought,",
      "translation": "而他们的装备方式，会让现代登山者一想到就心惊胆寒，",
      "startTime": 55.54,
      "endTime": 61.18,
