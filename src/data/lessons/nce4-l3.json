            "meaning": "招致，追求"
          }
        ]
      }
    },
    {
      "id": "s8",
      "role": "Woman",
      "text": "They had a single aim, a solitary goal -- the top!",
      "translation": "他们只有一个目标，唯一的追求——顶峰！",
      "startTime": 65.87,
      "endTime": 72.54,
      "analysis": {
        "words": [
          {
