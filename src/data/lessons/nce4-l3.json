          }
        ]
      }
    },
    {
      "id": "s13",
      "role": "Man",
      "text": "the food simply local cheese accompanied by bread often twelve months old,",
      "translation": "食物只是当地奶酪配上通常已放了一年的面包，",
      "startTime": 101.98,
