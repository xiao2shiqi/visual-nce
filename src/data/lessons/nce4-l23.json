    {
      "id": "intro_5",
      "role": "Narrator",
      "text": "No two sorts of birds practise quite the same sort of flight;",
      "translation": "没有两种鸟具有完全相同的飞行方式。",
      "startTime": 17.99,
      "endTime": 23.46
