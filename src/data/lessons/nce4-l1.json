            "meaning": "近东"
          }
        ]
      }
    },
    {
      "id": "s1",
      "role": "Man",
      "text": "where people first learned to write.",
      "translation": "那里的人们最早学会了书写。",
      "startTime": 23.28,
      "endTime": 26.91,
      "analysis": {
        "words": [
          {
