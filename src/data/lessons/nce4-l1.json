            "meaning": "写，书写"
          }
        ]
      }
    },
    {
      "id": "s2",
      "role": "Woman",
      "text": "But there are some parts of the world where even now people cannot write.",
      "translation": "但在世界上的一些地方，直到现在人们还不会写字。",
      "startTime": 26.92,
      "endTime": 33.39,
      "analysis": {
        "words": [
          {
            "word": "Even now",
            "pos": "adv.",
            "meaning": "甚至现在，直到现在"
          }
        ]
      }
    },
    {
      "id": "s3",
      "role": "Man",
      "text": "The only way that they can preserve their history is to recount it as sagas legends handed down from one generation of storytellers to another.",
      "translation": "他们保存历史的唯一途径是将其作为由一代代讲故事人流传下来的英雄传说。",
      "startTime": 33.4,
      "endTime": 46.14,
      "analysis": {
        "words": [
          {
            "word": "Preserve",
            "pos": "v.",
            "meaning": "保存"
          },
          {
            "word": "Recount",
            "pos": "v.",
            "meaning": "叙述，讲述"
          },
          {
            "word": "Sagas",
            "pos": "n.",
            "meaning": "长篇小说，英雄传说"
          }
        ]
      }
    },
    {
      "id": "s4",
      "role": "Woman",
      "text": "These legends are useful because they can tell us something about migrations of people who lived long ago,",
      "translation": "这些传说很有用，因为它们可以告诉我们一些关于很久以前生活的民族迁徙的情况，",
      "startTime": 46.15,
      "endTime": 54.21,
      "analysis": {
        "words": [
          {
            "word": "Migrations",
            "pos": "n.",
            "meaning": "迁徙"
          }
        ]
      }
    },
    {
      "id": "s5",
      "role": "Man",
      "text": "but none could write down what they did.",
      "translation": "但当时没有人能记下他们的所作所为。",
      "startTime": 54.22,
      "endTime": 57.66,
      "analysis": {
        "words": [
          {
