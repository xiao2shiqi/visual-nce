      "startTime": 54.98,
      "endTime": 57.74
    },
    {
      "id": "s11",
      "role": "Man",
      "text": "'I can't hear a word!' I said angrily.",
      "translation": "'我一个字也听不见！'我生气地说。",
      "startTime": 57.75,
