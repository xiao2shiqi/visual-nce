    {
      "id": "intro_5",
      "role": "Narrator",
      "text": "True eccentrics never deliberately set out to draw attention to themselves.",
      "translation": "真正的怪人从不有意引人注目。",
      "startTime": 16.37,
      "endTime": 22.1,
      "analysis": {
