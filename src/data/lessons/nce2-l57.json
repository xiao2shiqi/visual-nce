    {
      "id": "intro_3",
      "role": "Narrator",
      "text": "Though she hesitated for a moment,",
      "translation": "虽然她犹豫了片刻，",
      "startTime": 20.6,
      "endTime": 23.76
    },
    {
      "id": "intro_4",
