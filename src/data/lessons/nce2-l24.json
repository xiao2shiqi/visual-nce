    },
    {
      "id": "s1",
      "role": "Man",
      "text": "The manager was sympathetic, but he could do nothing.",
      "translation": "经理表示同情，但什么也做不了。",
      "startTime": 33.33,
      "endTime": 38.92,
      "analysis": {
        "words": []
      }
    },
    {
      "id": "s2",
      "role": "Woman",
      "text": "'Everyone's losing money these days,' he said.",
      "translation": "'现在大家都在丢钱，'他说。",
      "startTime": 38.93,
      "endTime": 44.07
    },
    {
      "id": "s3",
      "role": "Man",
      "text": "He started to complain about this wicked world but was interrupted by a knock at the door.",
      "translation": "他开始抱怨这个邪恶的世界，但被敲门声打断了。",
      "startTime": 44.08,
      "endTime": 52.52,
      "analysis": {
