        ]
      }
    },
    {
      "id": "s4",
      "role": "Woman",
      "text": "A girl came in and put an envelope on his desk.",
      "translation": "一个姑娘走了进来，把一个信封放在他的桌上。",
      "startTime": 52.53,
      "endTime": 56.97,
      "analysis": {
        "words": []
      }
    },
    {
      "id": "s5",
      "role": "Man",
      "text": "It contained ￡50.",
