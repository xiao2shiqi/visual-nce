          }
        ]
      }
    },
    {
      "id": "intro_2",
      "role": "Narrator",
      "text": "On Wednesday evening, we went to the Town Hall.",
      "translation": "星期三的晚上，我们去了市政厅。",
      "startTime": 15.22,
      "endTime": 19.28,
      "analysis": {
        "words": []
      }
    },
    {
      "id": "intro_3",
      "role": "Narrator",
      "text": "It was the last day of the year",
      "translation": "那是一年的最后一天，",
      "startTime": 19.29,
      "endTime": 21.85,
      "analysis": {
        "words": [
