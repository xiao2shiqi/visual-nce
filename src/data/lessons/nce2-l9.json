      "analysis": {
        "words": []
      }
    },
    {
      "id": "s3",
      "role": "Man",
      "text": "at five to twelve, the clock stopped.",
      "translation": "在差5分12点的时候，大钟停了。",
      "startTime": 34.22,
      "endTime": 37.84,
      "analysis": {
