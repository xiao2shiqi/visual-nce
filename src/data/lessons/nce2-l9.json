      "analysis": {
        "words": []
      }
    },
    {
      "id": "s7",
      "role": "Man",
      "text": "Suddenly someone shouted.",
      "translation": "突然有人喊道：",
      "startTime": 45.14,
      "endTime": 47.68,
      "analysis": {
        "words": []
      }
    },
    {
      "id": "s8",
      "role": "Woman",
      "text": "'It's two minutes past twelve!",
