    {
      "id": "intro_5",
      "role": "Narrator",
      "text": "Recent developments in astronomy have made it possible to detect planets in our own Milky Way and in other galaxies.",
      "translation": "天文学的最新发展使探测我们银河系及其他星系中的行星成为可能。",
      "startTime": 17.41,
      "endTime": 26.54,
      "analysis": {
        "words": [
          {
            "word": "astronomy",
            "pos": "n.",
            "meaning": "天文学"
          },
          {
            "word": "galaxy",
            "pos": "n.",
            "meaning": "星系"
          }
        ]
      }
    },
    {
      "id": "s1",
      "role": "Narrator",
      "text": "This is a major achievement because, in relative terms, planets are very small and do not emit light.",
      "translation": "这是一项重大成就，因为相对而言，行星非常小且不发光。",
      "startTime": 26.55,
      "endTime": 34.98,
      "analysis": {
        "words": [
          {
            "word": "emit",
            "pos": "v.",
            "meaning": "放射，散发"
          }
        ]
      }
    },
    {
      "id": "s2",
      "role": "Narrator",
      "text": "Finding planets is proving hard enough, but finding life on them will prove infinitely more difficult.",
      "translation": "寻找行星已经被证明足够难了，但在行星上寻找生命将被证明要难上无限倍。",
      "startTime": 34.99,
      "endTime": 42.51,
      "analysis": {
        "words": [
