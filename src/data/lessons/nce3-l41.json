            "pos": "n.",
            "meaning": "居住者"
          }
        ]
      }
    },
    {
      "id": "intro_5",
      "role": "Narrator",
      "text": "The quiet life of the country has never appealed to me.",
      "translation": "乡村宁静的生活从来没有吸引过我。",
      "startTime": 17.94,
      "endTime": 22.44,
      "analysis": {
        "words": [
          {
            "word": "appealed",
            "pos": "v.",
            "meaning": "引用，呼吁，吸引"
          }
        ]
      }
    },
    {
      "id": "s1",
      "role": "Narrator",
      "text": "City born and city bred,",
      "translation": "我在城市出生并在城市长大，",
      "startTime": 22.45,
      "endTime": 24.89,
      "analysis": {
        "words": [
          {
            "word": "bred",
            "pos": "v.",
            "meaning": "喂养，繁殖"
          }
        ]
      }
    },
    {
      "id": "s2",
      "role": "Narrator",
      "text": "I have always regarded the country as something you look at through a train window, or something you occasionally visit during the weekend.",
      "translation": "我总把乡村看作是那种你透过火车窗户往外看的东西，或者是你偶尔在周末去访问的地方。",
      "startTime": 24.9,
      "endTime": 35.6,
      "analysis": {
        "words": [
          {
            "word": "regarded",
            "pos": "v.",
            "meaning": "注重，尊敬"
          },
          {
            "word": "occasionally",
            "pos": "adv.",
            "meaning": "偶然地"
          }
        ]
      }
    },
    {
      "id": "s3",
      "role": "Narrator",
      "text": "Most of my friends live in the city, yet they always go into raptures at the mere mention of the country.",
      "translation": "我的大多数朋友都住在城市，然而只要一提到乡村，他们总是欣喜若狂。",
      "startTime": 35.61,
      "endTime": 45.17,
      "analysis": {
        "words": [
          {
            "word": "rapture",
            "pos": "n.",
            "meaning": "狂喜"
          }
        ]
      }
    },
    {
      "id": "s4",
      "role": "Narrator",
      "text": "Though they extol the virtues of the peaceful life,",
      "translation": "虽然他们赞美宁静生活的种种好处，",
