    },
    {
      "id": "s3",
      "role": "Man",
      "text": "Now he has put an ugly stone head over the gate.",
      "translation": "现在他在大门上方放了一个丑陋的石头像。",
      "startTime": 58.94,
      "endTime": 64.18
    },
    {
      "id": "s4",
      "role": "Woman",
      "text": "It is one of the ugliest faces I have ever seen.",
      "translation": "那是我见过的最丑陋的面孔之一。",
      "startTime": 64.19,
      "endTime": 69.5,
      "analysis": {
