    {
      "id": "intro_4",
      "role": "Narrator",
      "text": "What is Jasper White's problem?",
      "translation": "贾斯珀·怀特遇到了什么问题？",
      "startTime": 9.64,
      "endTime": 14.21,
      "analysis": {
