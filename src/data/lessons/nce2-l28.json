    },
    {
      "id": "intro_2",
      "role": "Narrator",
      "text": "Jasper White is one of those rare people who believes in ancient myths.",
      "translation": "贾斯珀·怀特是少有的相信古代神话的人之一。",
      "startTime": 14.22,
      "endTime": 21.11,
