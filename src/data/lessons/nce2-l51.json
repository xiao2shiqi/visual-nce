            "pos": "pron.",
            "meaning": "那个"
          },
          {
            "word": "Fat",
            "pos": "adj.",
            "meaning": "胖的"
          }
        ]
      }
    },
    {
      "id": "s6",
      "role": "Woman",
      "text": "He led me into his room and hurriedly hid a large parcel under his desk.",
      "translation": "他把我领进房间，慌忙把一个大包藏在书桌下面。",
      "startTime": 59.28,
      "endTime": 65.79,
      "analysis": {
        "words": [
