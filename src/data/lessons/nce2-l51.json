            "meaning": "很，非常"
          }
        ]
      }
    },
    {
      "id": "s8",
      "role": "Woman",
      "text": "When I asked him what he was doing,",
      "translation": "当我问他在干什么时，",
      "startTime": 70.03,
      "endTime": 72.69,
      "analysis": {
        "words": [
          {
