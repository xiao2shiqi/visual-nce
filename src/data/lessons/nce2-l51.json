            "meaning": "我（宾格）"
          }
        ]
      }
    },
    {
      "id": "s7",
      "role": "Man",
      "text": "It was obvious that he was very embarrassed.",
      "translation": "显然他感到很尴尬。",
      "startTime": 65.8,
      "endTime": 70.02,
      "analysis": {
        "words": [
          {
