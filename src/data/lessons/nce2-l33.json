{
  "id": "nce2-l33",
  "title": "Lesson 33: Out of the Darkness",
  "audio": "/audio/nce2/33－Out of the Darkness.mp3",
  "image": "/images/nce2/l33/scene1.jpg",
  "segments": [
    {
      "id": "intro_1",
      "role": "Narrator",
      "text": "Why was the girl in hospital?",
      "translation": "那个女孩为什么在医院里？",
      "startTime": 10.68,
      "endTime": 14.61
    },
    {
      "id": "intro_2",
      "role": "Narrator",
      "text": "Nearly a week passed before",
      "translation": "差不多过了一个星期，",
      "startTime": 14.62,
      "endTime": 16.95
    },
    {
      "id": "intro_3",
      "role": "Narrator",
      "text": "the girl was able to explain",
      "translation": "那姑娘才能够讲述",
      "startTime": 16.96,
      "endTime": 19.53
    },
    {
      "id": "intro_4",
      "role": "Narrator",
      "text": "what had happened to her.",
      "translation": "她的经历。",
      "startTime": 19.54,
      "endTime": 23.14,
      "analysis": {
        "words": [
          {
            "word": "What",
            "pos": "pron.",
            "meaning": "什么"
          }
        ]
      }
    },
    {
      "id": "s1",
      "role": "Man",
      "text": "One afternoon she set out",
      "translation": "一天下午她从海岸出发，",
      "startTime": 23.15,
      "endTime": 25.69
    },
    {
      "id": "s2",
      "role": "Woman",
      "text": "from the coast in a small boat",
      "translation": "乘小船出海，",
      "startTime": 25.7,
      "endTime": 28.21
    },
    {
      "id": "s3",
      "role": "Man",
      "text": "and was caught in a storm.",
      "translation": "遇上了风暴。",
      "startTime": 28.22,
      "endTime": 31.48
    },
    {
      "id": "s4",
      "role": "Woman",
      "text": "Towards evening,",
      "translation": "天将黑时，",
      "startTime": 31.49,
      "endTime": 33.08
    },
    {
      "id": "s5",
      "role": "Man",
      "text": "the boat struck a rock and",
      "translation": "小船撞到了一块礁石，",
      "startTime": 33.09,
      "endTime": 35.12
    },
    {
      "id": "s6",
      "role": "Woman",
      "text": "the girl jumped into the sea.",
      "translation": "姑娘跳进了海里。",
      "startTime": 35.13,
      "endTime": 38.29
    },
    {
      "id": "s7",
      "role": "Man",
      "text": "Then she swam to the shore",
      "translation": "她在海里游了一整夜之后，",
      "startTime": 38.3,
      "endTime": 40.62
    },
    {
      "id": "s8",
      "role": "Woman",
      "text": "after spending the whole night in the water.",
      "translation": "最后终于游到了岸边。",
      "startTime": 40.63,
      "endTime": 44.7
    },
    {
      "id": "s9",
      "role": "Man",
      "text": "During that time she covered",
      "translation": "在那段时间里，",
      "startTime": 44.71,
      "endTime": 47.49,
      "analysis": {
        "words": [
          {
            "word": "That",
            "pos": "pron.",
            "meaning": "那个"
          }
        ]
      }
    },
    {
      "id": "s10",
      "role": "Woman",
      "text": "a distance of eight miles.",
      "translation": "她游了8英里。",
      "startTime": 47.5,
      "endTime": 50.8
    },
    {
      "id": "s11",
      "role": "Man",
      "text": "Early next morning,",
      "translation": "第二天凌晨，",
      "startTime": 50.81,
      "endTime": 52.89
    },
    {
      "id": "s12",
      "role": "Woman",
      "text": "she saw a light ahead.",
      "translation": "她看到前面有一盏灯。",
      "startTime": 52.9,
      "endTime": 55.79
    },
    {
      "id": "s13",
      "role": "Man",
      "text": "She knew she was near the shore",
      "translation": "她知道她已快靠近岸了，",
      "startTime": 55.8,
      "endTime": 58.89
    },
    {
      "id": "s14",
      "role": "Woman",
      "text": "because the light was high up on the cliffs.",
      "translation": "因为那灯是在悬崖高处。",
      "startTime": 58.9,
      "endTime": 63.5
    },
    {
      "id": "s15",
      "role": "Man",
      "text": "On arriving at the shore,",
      "translation": "到达岸边后，",
      "startTime": 63.51,
      "endTime": 66.15,
      "analysis": {
        "words": [
          {
            "word": "At",
            "pos": "prep.",
            "meaning": "在...（小地点/时刻）"
          }
        ]
      }
    },
    {
      "id": "s16",
      "role": "Woman",
      "text": "the girl struggled up the cliff towards",
      "translation": "姑娘朝着她看到的那盏灯的方向，",
      "startTime": 66.16,
      "endTime": 69.55
    },
    {
      "id": "s17",
      "role": "Man",
      "text": "the light she had seen.",
      "translation": "挣扎着往悬崖上爬去。",
      "startTime": 69.56,
      "endTime": 72.08
    },
    {
      "id": "s18",
      "role": "Woman",
      "text": "That was all she remembered.",
      "translation": "她所记得的就是这些。",
      "startTime": 72.09,
      "endTime": 75.16,
      "analysis": {
        "words": [
          {
            "word": "That",
            "pos": "pron.",
            "meaning": "那个"
          }
        ]
      }
    },
    {
      "id": "s19",
      "role": "Man",
      "text": "When she woke up a day later,",
      "translation": "她醒来时已是第二天了，",
      "startTime": 75.17,
      "endTime": 77.96
    },
    {
      "id": "s20",
      "role": "Woman",
      "text": "she found herself in hospital.",
      "translation": "发现自己躺在医院里。",
      "startTime": 77.97,
      "endTime": 82.97
    }
  ]
}