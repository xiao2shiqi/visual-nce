          {
            "word": "joke",
            "pos": "n.",
            "meaning": "笑话，恶作剧"
          }
        ]
      }
    },
    {
      "id": "s1",
      "role": "Narrator",
      "text": "Students specialize in a particular type of practical joke: the hoax.",
      "translation": "学生们擅长一种特定类型的恶作剧：恶作剧骗局。",
      "startTime": 22.71,
      "endTime": 28.78,
      "analysis": {
