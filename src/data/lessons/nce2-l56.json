    },
    {
      "id": "intro_2",
      "role": "Narrator",
      "text": "Once a year, a race is held for old cars.",
      "translation": "每年都有一场为老式汽车举办的比赛。",
      "startTime": 15.46,
      "endTime": 20.92,
