            "pos": "n.",
            "meaning": "书"
          }
        ]
      }
    },
    {
      "id": "s13",
      "role": "Man",
      "text": "which I found most helpful on the cross-country journey, but which I did not think I should need on the last stage.",
      "translation": "她给了我正确的零钱。",
      "startTime": 96.93,
      "endTime": 104.61,
      "analysis": {
        "words": [
          {
            "word": "Not",
            "pos": "adv.",
            "meaning": "不，不是"
          }
        ]
      }
    },
    {
      "id": "s14",
      "role": "Woman",
      "text": "It was not that I actually remembered anything at all.",
      "translation": "'你以前住在希尔福德吗？'她问。",
      "startTime": 104.62,
      "endTime": 108.55,
      "analysis": {
        "words": [
          {
            "word": "It",
            "pos": "pron.",
            "meaning": "它"
          },
          {
            "word": "Not",
            "pos": "adv.",
            "meaning": "不，不是"
          },
          {
