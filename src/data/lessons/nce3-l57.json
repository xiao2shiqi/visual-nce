            "pos": "adv.",
            "meaning": "也"
          }
        ]
      }
    },
    {
      "id": "s36",
      "role": "Woman",
      "text": "The lake was not a natural one, but a man-made reservoir.",
      "translation": "这个湖不是天然的，而是一个人造水库。",
      "startTime": 218.49,
      "endTime": 223.49,
