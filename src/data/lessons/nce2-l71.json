    },
    {
      "id": "intro_2",
      "role": "Narrator",
      "text": "When you visit London, one of the first things you will see is Big Ben,",
      "translation": "当你游览伦敦时，首先看到的景物之一就是大本钟，",
      "startTime": 15.41,
      "endTime": 21.98,
      "analysis": {
