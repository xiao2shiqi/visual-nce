    },
    {
      "id": "s6",
      "role": "Woman",
      "text": "Big Ben has rarely gone wrong.",
      "translation": "大本钟很少出差错。",
      "startTime": 77.47,
      "endTime": 81.15,
      "analysis": {
        "words": []
      }
    },
    {
      "id": "s7",
      "role": "Man",
      "text": "Once, however, it failed to give the correct time.",
