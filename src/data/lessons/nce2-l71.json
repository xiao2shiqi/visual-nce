          }
        ]
      }
    },
    {
      "id": "intro_3",
      "role": "Narrator",
      "text": "the famous clock which can be heard all over the world on the B.B.C.",
      "translation": "那是一座著名的钟，你可以在英国广播公司的节目中听到全世界都能听到的钟声。",
      "startTime": 21.99,
      "endTime": 29.07,
      "analysis": {
        "words": []
      }
    },
    {
      "id": "intro_4",
      "role": "Narrator",
      "text": "If the Houses of Parliament had not been burned down in 1834,",
      "translation": "如果不是国会大厦在1834年被焚毁的话，",
      "startTime": 29.08,
      "endTime": 35.35,
      "analysis": {
        "words": [
          {
            "word": "Not",
            "pos": "adv.",
            "meaning": "不，不是"
          }
        ]
      }
    },
    {
      "id": "s1",
      "role": "Man",
      "text": "the great clock would never have been erected.",
      "translation": "大钟就不会建造了。",
      "startTime": 35.36,
      "endTime": 39.86,
      "analysis": {
        "words": []
      }
    },
    {
      "id": "s2",
      "role": "Woman",
      "text": "Big Ben takes its name from Sir Benjamin Hall who was responsible for the making of the clock when the new Houses of Parliament were being built.",
      "translation": "大本钟得名于本杰明·霍尔爵士，当时他负责在新国会大厦建造时制造这口钟。",
      "startTime": 39.87,
      "endTime": 52.5,
      "analysis": {
        "words": [
          {
            "word": "Name",
            "pos": "n.",
            "meaning": "名字"
          },
          {
            "word": "Sir",
            "pos": "n.",
            "meaning": "先生"
          }
        ]
      }
    },
    {
      "id": "s3",
      "role": "Man",
      "text": "It is not only of immense size, but is extremely accurate as well.",
      "translation": "它不仅巨大，而且非常精确。",
      "startTime": 52.51,
      "endTime": 60.34,
      "analysis": {
        "words": [
