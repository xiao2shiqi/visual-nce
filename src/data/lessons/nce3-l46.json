    {
      "id": "intro_5",
      "role": "Narrator",
      "text": "So great is our passion for doing things for ourselves,",
      "translation": "我们对凡事亲自动手的热情是如此之大，",
      "startTime": 16.95,
      "endTime": 21.39,
