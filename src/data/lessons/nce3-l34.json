    {
      "id": "s1",
      "role": "Narrator",
      "text": "Antique shops exert a peculiar fascination on a great many people.",
      "translation": "古玩店对许多人来说具有一种特殊的魅力。",
      "startTime": 14.53,
      "endTime": 21.19,
      "analysis": {
