            "pos": "n.",
            "meaning": "宫殿，府邸"
          },
          {
            "word": "republic",
            "pos": "n.",
            "meaning": "共和国"
          }
        ]
      }
    },
    {
      "id": "s2",
      "role": "Woman",
      "text": "When the article arrived, the editor read the first sentence and then refused to publish it.",
      "translation": "稿子送到后，主编看第一句话就拒不发表。",
      "startTime": 35.09,
      "endTime": 42.42,
      "analysis": {
