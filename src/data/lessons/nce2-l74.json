            "meaning": "它"
          }
        ]
      }
    },
    {
      "id": "s11",
      "role": "Man",
      "text": "'Look, sheriff,' said Rockwall,",
      "translation": "'听着，警长，'罗克沃尔说，",
      "startTime": 103.12,
      "endTime": 106.53,
      "analysis": {
