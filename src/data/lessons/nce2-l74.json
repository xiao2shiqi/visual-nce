    },
    {
      "id": "s13",
      "role": "Man",
      "text": "'Oh, is it?' said the sheriff with a sneer.",
      "translation": "'哦，是吗？'警长冷笑着说。",
      "startTime": 115.69,
      "endTime": 120.1,
      "analysis": {
