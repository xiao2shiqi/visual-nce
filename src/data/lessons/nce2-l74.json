            "meaning": "这里"
          }
        ]
      }
    },
    {
      "id": "s10",
      "role": "Woman",
      "text": "'I'm sheriff here. Do you see that notice? It says \"No Camping\"  -- in case you can't read!'",
      "translation": "'我是这里的警长。你们看到那个告示了吗？上面写着"禁止露营"——以防你们不识字！'",
      "startTime": 91.29,
      "endTime": 103.11,
      "analysis": {
        "words": [
          {
            "word": "Here",
            "pos": "adv.",
            "meaning": "这里"
