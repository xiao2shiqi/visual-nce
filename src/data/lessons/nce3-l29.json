    },
    {
      "id": "s14",
      "role": "Narrator",
      "text": "He dreaded having to spend Christmas in hospital.",
      "translation": "他害怕不得不在医院里过圣诞节。",
      "startTime": 108.84,
      "endTime": 112.71,
      "analysis": {
